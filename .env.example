# Synology host paths. Change these if the shared-folder names differ.
MUSIC_LIBRARY_PATH=/volume2/music
MUSIC_QUARANTINE_PATH=/volume1/music-dedup-quarantine
MUSIC_REPORT_PATH=/volume1/music-dedup-reports
MUSIC_CONFIG_PATH=/volume1/music-dedup-config

# Web control console. Set a strong token before exposing the port to a network.
WEB_PORT=8080
WEB_TOKEN=
WEB_RUN_ON_START=true
